# Copiez ce fichier en backend/.env et remplacez TOUTES les valeurs d'exemple.
POSTGRES_USER=merveille
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-long-et-unique
POSTGRES_DB=merveille
# Le nom d'hôte "db" est le service PostgreSQL de docker-compose. Utilisez le même mot de passe que ci-dessus.
DATABASE_URL=postgres://merveille:remplacez-par-un-mot-de-passe-long-et-unique@db:5432/merveille
# Générer : openssl rand -base64 48
JWT_SECRET=
# Identifiants client OAuth Google (web, Android, iOS) séparés par des virgules. Laisser vide = connexion Google désactivée.
GOOGLE_CLIENT_IDS=
PORT=3000
UPLOAD_DIR=/data/uploads
# 1 si l'API est derrière un proxy HTTPS (Caddy, Nginx…)
TRUST_PROXY=0
CORS_ORIGIN=*
