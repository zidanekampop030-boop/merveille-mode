# Copiez ce fichier en .env à la racine du projet mobile.
# Adresse de l'API (voir README). Émulateur Android : http://10.0.2.2:3000 ; téléphone réel : l'IP de votre PC (ex. http://192.168.1.10:3000) ; production : https://api.votre-domaine.com
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Numéro WhatsApp de la boutique, format international sans "+"
EXPO_PUBLIC_WHATSAPP=237681546178
# Connexion Google (facultatif) : identifiants client OAuth créés dans Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
